{
  "manifest_version": 3,
  "name": "Lagosystem Bridge",
  "version": "0.2.0",
  "description": "GPL generic local-device Native Messaging bridge; per-site and per-device user consent",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@lagosystem.com.br"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local device bridge — site permissions",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "96": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
