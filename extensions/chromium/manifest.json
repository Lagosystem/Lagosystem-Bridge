{
  "manifest_version": 3,
  "name": "Lagosystem Bridge",
  "version": "0.1.0",
  "description": "Secure Lagosystem local hardware and document bridge",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sistema.lagosystem.com.br/*",
        "http://localhost:4200/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}